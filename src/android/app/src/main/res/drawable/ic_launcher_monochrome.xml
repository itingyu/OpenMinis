<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome counterpart to the geometric Kite icon (ic_launcher_foreground.png).
  Android 13+ Themed Icons tint this silhouette with the system palette, so it
  is drawn as a single solid shape in white.

  Same geometry as the coloured foreground: a diamond ring (outer rhombus with
  an inner one cut out, evenOdd) plus a solid centre diamond. Everything stays
  inside the inscribed circle of the safe zone — centre (54,54), radius 33 —
  because the circular mask is the binding clip: the outer vertices sit at
  sqrt(27^2 + 27^2) ... no: they sit at 28 from centre (54,26)/(82,54) etc.,
  well within 33, so no clipping on any mask shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,26 L82,54 L54,82 L26,54 Z M54,42 L66,54 L54,66 L42,54 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,50 L58,54 L54,58 L50,54 Z" />
</vector>
